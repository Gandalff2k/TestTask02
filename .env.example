POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support

# groq | gemini | openrouter | openai | custom
LLM_PROVIDER=groq
# Без ключа сервіс робить справжній запит і використовує статичну відповідь.
LLM_API_KEY=
# Обов'язково для openrouter, openai, custom. Для groq і gemini є значення за замовчуванням.
LLM_MODEL=
# Лише для custom, наприклад http://host.docker.internal:11434/v1 для Ollama.
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_RATE_LIMIT_PER_MINUTE=60
LLM_KEYLESS_DELAY_MIN_SECONDS=5
LLM_KEYLESS_DELAY_MAX_SECONDS=30

# Адреса, за якою клієнт відкриватиме посилання на статті з чернетки.
PUBLIC_BASE_URL=http://localhost:8000

# Якщо пароль задано, інтерфейс оператора вимагає Basic Auth. Порожній пароль означає відкритий доступ.
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

WORKER_CONCURRENCY=30
GENERATION_LEASE_SECONDS=180
GENERATION_MAX_ATTEMPTS=5

# Хости, на які дозволено надсилати відповіді (захист від SSRF через reply_url), через кому.
HELPDESK_ALLOWED_HOSTS=mock-helpdesk
DELIVERY_CONCURRENCY=5
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_READ_TIMEOUT_SECONDS=10

# Поведінка мока хелпдеску: частка відповідей 503, частка «завис і не прийняв»,
# частка «прийняв, але не встиг відповісти» і скільки секунд він «висить».
MOCK_ERROR_RATE=0.2
MOCK_SLOW_RATE=0.05
MOCK_ACCEPT_THEN_SLOW_RATE=0.05
MOCK_SLOW_SECONDS=15

LOG_LEVEL=INFO

# Лише для прод-деплою
APP_HOST=
MOCK_HOST=
